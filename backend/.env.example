# JSON array of allowed frontend origins. Defaults to ["http://localhost:5173"] if unset -
# once the frontend is deployed, set this to its real URL or the browser will get CORS errors.
# CORS_ORIGINS=["https://your-deployed-frontend.example.com"]

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ABA PayWay (sandbox: https://checkout-sandbox.payway.com.kh). The API key is what PayWay's
# onboarding email calls the "public key" - it signs every request.
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
# Public URL of this backend's /wallet/topup/payway/callback; leave empty in local dev, the Wallet
# page's polling settles card top-ups on its own.
PAYWAY_CALLBACK_URL=

# Platform's commission cut of a completed booking (%). Tracked per-booking only - no escrow.
PLATFORM_COMMISSION_PCT=15.0
