# JSON array of allowed frontend origins. Defaults to ["http://localhost:5173"] if unset -
# once the frontend is deployed, set this to its real URL or the browser will get CORS errors.
# CORS_ORIGINS=["https://your-deployed-frontend.example.com"]

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode secret key from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=

# Platform's commission cut of a completed booking (%). Tracked per-booking only - no escrow.
PLATFORM_COMMISSION_PCT=15.0
