Enum "user_role" {
  "user"
  "admin"
}

Enum "pal_application_status" {
  "pending_review"
  "approved"
  "rejected"
}

Enum "payout_schedule" {
  "weekly"
  "bi_weekly"
  "monthly"
}

Enum "booking_status" {
  "pending"
  "accepted"
  "declined"
  "completed"
}

Enum "payment_method" {
  "coins"
  "card"
}

Enum "cancellation_refund_option" {
  "full"
  "partial"
  "none"
}

Enum "dispute_requested_outcome" {
  "full_refund"
  "partial_refund"
  "reporting"
}

Enum "dispute_status" {
  "open"
  "investigating"
  "resolved"
  "refunded"
}

Enum "notification_type" {
  "booking"
  "message"
  "review"
  "payout"
  "follow"
  "service"
  "gift"
  "streak"
  "moderation"
}

Enum "feed_category" {
  "games"
  "chilling"
  "clips"
}

Enum "post_kind" {
  "user"
  "status"
}

Enum "saved_item_kind" {
  "post"
  "service"
}

Enum "subscription_billing_cycle" {
  "monthly"
  "quarterly"
}

Enum "subscription_status" {
  "active"
  "cancelled"
}

Enum "wallet_transaction_kind" {
  "topup"
  "order"
  "refund"
  "payout"
  "tip"
}

Enum "wallet_transaction_status" {
  "completed"
  "pending"
  "blocked"
}

Enum "withdrawal_status" {
  "requested"
  "paid"
  "in_progress"
  "rejected"
}

Enum "flagged_player_status" {
  "pending"
  "reviewing"
  "actioned"
  "dismissed"
}

Enum "album_item_kind" {
  "clip"
  "screenshot"
}

Enum "review_sentiment" {
  "positive"
  "neutral"
  "negative"
}

Table "users" {
  "id" uuid [pk]
  "email" text [unique, not null]
  "handle" text [unique]
  "display_name" text
  "phone" text
  "country" text
  "role" user_role [not null, default: 'user']
  "onboarding_complete" boolean [not null, default: false]
  "coin_balance" integer [not null, default: 0]
  "posts_count" integer [not null, default: 0]
  "followers_count" integer [not null, default: 0]
  "following_count" integer [not null, default: 0]
  "created_at" timestamptz [not null, default: `now()`]
}

Table "players" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "user_id" uuid
  "display_name" text [not null]
  "avatar_url" text
  "tagline" text
  "bio" text
  "timezone" text
  "language" text
  "tier" text
  "highlight_badge" text
  "subscribe_label" text
  "games" "text[]" [not null, default: '{}']
  "rank" text
  "role" text
  "languages" "text[]" [not null, default: '{}']
  "price_per_hour" numeric(10,2)
  "rating" numeric(3,2)
  "review_count" integer [not null, default: 0]
  "online" boolean [not null, default: false]
  "is_new" boolean [not null, default: true]
  "status" pal_application_status [not null, default: 'approved']
  "is_banned" boolean [not null, default: false]
  "highlighted_service_id" uuid
  "payout_schedule" payout_schedule [not null, default: 'weekly']
  "id_front_url" text
  "id_back_url" text
  "rank_verification_url" text
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: "players_user_id_idx"]
    (status, is_banned) [name: "players_status_is_banned_idx"]
  }
}

Table "user_blocks" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "blocker_id" uuid [not null]
  "blocked_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `blocker_id <> blocked_id` [name: 'user_blocks_no_self']
  }

  Indexes {
    (blocker_id, blocked_id) [unique, name: "user_blocks_unique"]
    blocker_id [name: "user_blocks_blocker_id_idx"]
    blocked_id [name: "user_blocks_blocked_id_idx"]
  }
}

Table "active_sessions" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "device" text
  "location" text
  "last_active_at" timestamptz [not null, default: `now()`]
  "is_current" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: "active_sessions_user_id_idx"]
  }
}

Table "services" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "player_id" uuid [not null]
  "name" text [not null]
  "description" text
  "cover_image_url" text
  "styles" "text[]" [not null, default: '{}']
  "platforms" "text[]" [not null, default: '{}']
  "whats_included" "text[]" [not null, default: '{}']
  "avg_response_time" text
  "rating" numeric(3,2)
  "served_count" integer [not null, default: 0]
  "active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    player_id [name: "services_player_id_idx"]
  }
}

Table "service_pricing_options" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "service_id" uuid [not null]
  "label" text [not null]
  "price_coins" integer [not null, default: 0]
  "price_unit" text [not null]
  "sort_order" integer [not null, default: 0]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    service_id [name: "service_pricing_options_service_id_idx"]
  }
}

Table "service_promotions" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "service_id" uuid [not null]
  "label" text [not null]
  "discount_type" text [not null, check: `discount_type in ('percent_off', 'flat_off', 'first_order_free')`]
  "discount_value" numeric(10,2)
  "active" boolean [not null, default: true]
  "starts_at" timestamptz
  "ends_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    service_id [name: "service_promotions_service_id_idx"]
  }
}

Table "album_items" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "player_id" uuid [not null]
  "kind" album_item_kind [not null]
  "label" text
  "media_url" text
  "views" integer [not null, default: 0]
  "likes" integer [not null, default: 0]
  "shares" integer [not null, default: 0]
  "duration_seconds" integer
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    player_id [name: "album_items_player_id_idx"]
  }
}

Table "wish_items" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "player_id" uuid [not null]
  "service_id" uuid
  "title" text [not null]
  "game" text
  "type" text
  "price_coins" integer [not null, default: 0]
  "saved" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    player_id [name: "wish_items_player_id_idx"]
  }
}

Table "addons" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "label" text [not null]
  "price_coins" integer [not null, default: 0]
  "created_at" timestamptz [not null, default: `now()`]
}

Table "bookings" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "order_number" text [unique, not null]
  "player_id" uuid [not null]
  "service_id" uuid [not null]
  "user_id" uuid [not null]
  "status" booking_status [not null, default: 'pending']
  "service_type_label" text [not null]
  "price_coins" integer [not null, default: 0]
  "price_unit" text [not null]
  "quantity" integer [not null, default: 1]
  "promo_label" text
  "subtotal_coins" integer [not null, default: 0]
  "addons_coins" integer [not null, default: 0]
  "discount_coins" integer [not null, default: 0]
  "total_coins" integer [not null, default: 0]
  "commission_pct" numeric [not null, default: 0]
  "commission_coins" integer [not null, default: 0]
  "payment_method" payment_method [not null, default: 'coins']
  "scheduled_for" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    player_id [name: "bookings_player_id_idx"]
    user_id [name: "bookings_user_id_idx"]
    status [name: "bookings_status_idx"]
    (status, created_at) [name: "bookings_status_created_at_idx"]
  }
}

Table "booking_addons" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "booking_id" uuid [not null]
  "addon_id" uuid [not null]
  "label" text [not null]
  "price_coins" integer [not null, default: 0]

  Indexes {
    booking_id [name: "booking_addons_booking_id_idx"]
  }
}

Table "order_cancellations" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "booking_id" uuid [not null]
  "cancelled_by" uuid [not null]
  "reason" text [not null]
  "refund_option" cancellation_refund_option [not null]
  "refund_coins" integer [not null, default: 0]
  "note" text
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [name: "order_cancellations_booking_id_idx"]
  }
}

Table "order_disputes" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "booking_id" uuid [not null]
  "reported_by" uuid [not null]
  "reason" text [not null]
  "requested_outcome" dispute_requested_outcome [not null]
  "refund_coins" integer
  "note" text
  "attachment_urls" "text[]" [not null, default: '{}']
  "status" dispute_status [not null, default: 'open']
  "created_at" timestamptz [not null, default: `now()`]
  "resolved_at" timestamptz

  Indexes {
    booking_id [name: "order_disputes_booking_id_idx"]
    status [name: "order_disputes_status_idx"]
  }
}

Table "reviews" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "service_id" uuid [not null]
  "booking_id" uuid
  "author_id" uuid [not null]
  "rating" integer [not null, check: `rating between 1 and 5`]
  "text" text
  "sentiment" review_sentiment [not null, default: 'neutral']
  "highlights" "text[]" [not null, default: '{}']
  "tip_coins" integer [not null, check: `tip_coins >= 0`, default: 0]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    service_id [name: "reviews_service_id_idx"]
    booking_id [unique, name: "reviews_booking_id_key"]
  }
}

Table "message_threads" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "user_a_id" uuid [not null]
  "user_b_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (user_a_id, user_b_id) [unique]
  }
}

Table "messages" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "thread_id" uuid [not null]
  "sender_id" uuid [not null]
  "body" text [not null, default: '']
  "image_url" text
  "read_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    thread_id [name: "messages_thread_id_idx"]
    (thread_id, created_at) [name: "messages_thread_id_created_at_idx"]
    (thread_id, sender_id) [name: "messages_unread_idx"]
  }
}

Table "message_thread_states" {
  "thread_id" uuid [not null]
  "user_id" uuid [not null]
  "muted" boolean [not null, default: false]
  "deleted_at" timestamptz

  Indexes {
    (thread_id, user_id) [pk]
  }
}

Table "posts" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "author_id" uuid [not null]
  "text" text
  "image_url" text
  "image_urls" "text[]" [not null, default: '{}']
  "category" feed_category [not null, default: 'games']
  "kind" post_kind [not null, default: 'user']
  "tag" text
  "likes_count" integer [not null, default: 0]
  "comments_count" integer [not null, default: 0]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    author_id [name: "posts_author_id_idx"]
    tag [name: "posts_tag_idx"]
  }
}

Table "comments" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "post_id" uuid [not null]
  "author_id" uuid [not null]
  "parent_comment_id" uuid
  "text" text [not null]
  "likes_count" integer [not null, default: 0]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    post_id [name: "comments_post_id_idx"]
  }
}

Table "post_likes" {
  "user_id" uuid [not null]
  "post_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, post_id) [pk]
  }
}

Table "comment_likes" {
  "user_id" uuid [not null]
  "comment_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, comment_id) [pk]
  }
}

Table "follows" {
  "follower_id" uuid [not null]
  "followed_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `follower_id <> followed_id` [name: 'follows_no_self_follow']
  }

  Indexes {
    (follower_id, followed_id) [pk]
  }
}

Table "saved_items" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "kind" saved_item_kind [not null]
  "post_id" uuid
  "service_id" uuid
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `(kind = 'post' and post_id is not null and service_id is null)
    or (kind = 'service' and service_id is not null and post_id is null)` [name: 'saved_items_kind_target_check']
  }

  Indexes {
    (user_id, post_id) [unique]
    (user_id, service_id) [unique]
    user_id [name: "saved_items_user_id_idx"]
  }
}

Table "notifications" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "type" notification_type [not null]
  "message" text [not null]
  "thread_id" uuid
  "read" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: "notifications_user_id_idx"]
  }
}

Table "subscriptions" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "player_id" uuid [not null]
  "service_id" uuid
  "billing_cycle" subscription_billing_cycle [not null]
  "renews_on" date [not null]
  "price_coins" integer [not null, default: 0]
  "status" subscription_status [not null, default: 'active']
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: "subscriptions_user_id_idx"]
    player_id [name: "subscriptions_player_id_idx"]
  }
}

Table "topup_packages" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "coins" integer [not null]
  "price_usd" numeric(10,2) [not null]
  "bonus_coins" integer [not null, default: 0]
  "is_base_rate" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]
}

Table "payout_methods" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "player_id" uuid [not null]
  "brand" text [not null]
  "label" text [not null]
  "detail" text
  "is_default" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    player_id [name: "payout_methods_player_id_idx"]
  }
}

Table "withdrawals" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "player_id" uuid [not null]
  "payout_method_id" uuid
  "coins" integer [not null]
  "fee_coins" integer [not null, default: 0]
  "reference" text
  "status" withdrawal_status [not null, default: 'requested']
  "reviewed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    player_id [name: "withdrawals_player_id_idx"]
    status [name: "withdrawals_status_idx"]
    reference [unique, name: "withdrawals_reference_key"]
  }
}

Table "wallet_transactions" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "kind" wallet_transaction_kind [not null]
  "status" wallet_transaction_status [not null, default: 'completed']
  "label" text [not null]
  "detail" text
  "coins" integer [not null]
  "booking_id" uuid
  "withdrawal_id" uuid
  "payment_reference" text [unique]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: "wallet_transactions_user_id_idx"]
  }
}

Table "payway_topups" {
  "tran_id" text [pk]
  "user_id" uuid [not null]
  "package_id" uuid
  "method" text [not null, default: 'card']
  "coins" integer [not null]
  "amount_usd" numeric(10,2) [not null]
  "status" text [not null, default: 'pending']
  "created_at" timestamptz [not null, default: `now()`]
  "paid_at" timestamptz

  Indexes {
    (user_id, created_at) [name: "payway_topups_user_id_idx"]
  }
}

Table "payment_cards" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "user_id" uuid [not null]
  "brand" text [not null]
  "label" text [not null]
  "detail" text
  "is_default" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: "payment_cards_user_id_idx"]
  }
}

Table "admin_flags" {
  "id" uuid [pk, default: `gen_random_uuid()`]
  "player_id" uuid [not null]
  "reason" text [not null]
  "details" text
  "reported_by" uuid
  "report_count" integer [not null, default: 1]
  "status" flagged_player_status [not null, default: 'pending']
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    player_id [name: "admin_flags_player_id_idx"]
    status [name: "admin_flags_status_idx"]
  }
}

