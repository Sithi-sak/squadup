# Used only for Supabase Auth (session/login) once real auth is wired in (2.5).
# All data access still goes through the FastAPI backend, not this client directly.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of the FastAPI backend (lib/api.ts), no trailing slash.
VITE_API_URL=http://localhost:8000

# Stripe publishable key (test mode, from https://dashboard.stripe.com/test/apikeys - same
# dashboard page as the backend's secret key, this is the "pk_test_..." one). Mounts the card
# Element on Wallet Top-up (lib/stripe.ts).
VITE_STRIPE_PUBLISHABLE_KEY=
